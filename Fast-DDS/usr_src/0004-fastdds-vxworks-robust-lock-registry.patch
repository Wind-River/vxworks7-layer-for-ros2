     std::string name_;
     int fd_;
 
+#ifdef __VXWORKS__
+    // A shared lock this process already holds on file_path: join it (same descriptor, one
+    // more holder) instead of opening a second descriptor, whose close would drop the lock.
+    // As with BSD flock(), the existing shared lock means "not released". Registry held.
+    bool join_held(
+            const std::string& file_path,
+            bool* was_lock_created,
+            bool* was_lock_released)
+    {
+        RobustLockRegistry::Entry* e = RobustLockRegistry::find(file_path);
+        if (e == nullptr)
+        {
+            return false;
+        }
+        if (e->exclusive)
+        {
+            throw std::runtime_error(("failed to lock " + file_path + " (locked by this process)").c_str());
+        }
+        e->count++;
+        fd_ = e->fd;
+        *was_lock_created = false;
+        if (was_lock_released != nullptr)
+        {
+            *was_lock_released = false;
+        }
+        return true;
+    }
+#endif // ifdef __VXWORKS__
+
     enum class LockStatus
     {
         NOT_LOCKED,
