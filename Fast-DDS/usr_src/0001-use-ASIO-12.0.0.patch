From cda3ea873cd529ee9461945fac8afea82b7fd242 Mon Sep 17 00:00:00 2001
From: Andrei Kholodnyi <andrei.kholodnyi@windriver.com>
Date: Thu, 28 Aug 2025 13:33:28 +0200
Subject: [PATCH] use ASIO 12.0.0

---
 cmake/modules/FindAsio.cmake                        | 2 +-
 src/cpp/rtps/transport/TCPChannelResourceSecure.cpp | 8 ++++----
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/cmake/modules/FindAsio.cmake b/cmake/modules/FindAsio.cmake
index ce8f22d06..9a8f262da 100644
--- a/cmake/modules/FindAsio.cmake
+++ b/cmake/modules/FindAsio.cmake
@@ -1,4 +1,4 @@
-set(ASIO_REQUIRED_VERSION ${FIND_VERSION})
+set(ASIO_REQUIRED_VERSION 1.12.0)
 
 if (THIRDPARTY_Asio STREQUAL "FORCE" OR ANDROID)
     find_path(Asio_INCLUDE_DIR NAMES asio.hpp NO_CMAKE_FIND_ROOT_PATH)
diff --git a/src/cpp/rtps/transport/TCPChannelResourceSecure.cpp b/src/cpp/rtps/transport/TCPChannelResourceSecure.cpp
index 7cb2307a7..4ac46c63a 100644
--- a/src/cpp/rtps/transport/TCPChannelResourceSecure.cpp
+++ b/src/cpp/rtps/transport/TCPChannelResourceSecure.cpp
@@ -41,8 +41,8 @@ TCPChannelResourceSecure::TCPChannelResourceSecure(
     : TCPChannelResource(parent, locator, maxMsgSize)
     , context_(context)
     , ssl_context_(ssl_context)
-    , strand_read_(make_strand(context))
-    , strand_write_(make_strand(context))
+    , strand_read_(asio::strand<asio::io_context::executor_type>(context.get_executor()))
+    , strand_write_(asio::strand<asio::io_context::executor_type>(context.get_executor()))
 {
 }
 
@@ -55,8 +55,8 @@ TCPChannelResourceSecure::TCPChannelResourceSecure(
     : TCPChannelResource(parent, maxMsgSize)
     , context_(context)
     , ssl_context_(ssl_context)
-    , strand_read_(make_strand(context))
-    , strand_write_(make_strand(context))
+    , strand_read_(asio::strand<asio::io_context::executor_type>(context.get_executor()))
+    , strand_write_(asio::strand<asio::io_context::executor_type>(context.get_executor()))
     , secure_socket_(socket)
 {
     set_tls_verify_mode(parent->configuration());
-- 
2.34.1

