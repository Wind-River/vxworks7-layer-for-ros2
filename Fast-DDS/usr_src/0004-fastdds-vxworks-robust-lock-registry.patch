+#ifndef _FASTDDS_ROBUST_LOCK_REGISTRY_H_
+#define _FASTDDS_ROBUST_LOCK_REGISTRY_H_
+
+#ifdef __VXWORKS__
+
+#include <map>
+#include <mutex>
+#include <string>
+
+namespace eprosima {
+namespace fastdds {
+namespace rtps {
+
+/**
+ * VxWorks: the lock files this process holds (RobustExclusiveLock / RobustSharedLock).
+ *
+ * VxWorks has no flock(); unixextra emulates it with fcntl() record locks, which belong to
+ * the process, and the kernel drops all of them on a file as soon as the process closes
+ * ANY descriptor of it. The robust locks open a second descriptor for zombie tests and
+ * is_locked() and close it again, which on a file the process holds itself both gave the
+ * wrong answer (the process' own lock does not conflict) and dropped the real lock (a peer
+ * then removed a live port as zombie, and its listener never received data).
+ *
+ * So the process never opens a second descriptor on a lock file it holds: it answers from
+ * here. Acquire and release run under mutex(), so two threads cannot race on one file.
+ */
+class RobustLockRegistry
+{
+public:
+
+    struct Entry
+    {
+        int fd;
+        unsigned count;     // holders: 1 for exclusive, >= 1 for shared
+        bool exclusive;
+    };
+
+    static std::recursive_mutex& mutex()
+    {
+        static std::recursive_mutex* m = new std::recursive_mutex;  // never destroyed: used until exit
+        return *m;
+    }
+
+    // the entry for the lock file at path, or nullptr; call with mutex() held
+    static Entry* find(
+            const std::string& path)
+    {
+        auto it = entries().find(path);
+        return it == entries().end() ? nullptr : &it->second;
+    }
+
+    static void add(
+            const std::string& path,
+            int fd,
+            bool exclusive)
+    {
+        entries()[path] = Entry{fd, 1, exclusive};
+    }
+
+    static void erase(
+            const std::string& path)
+    {
+        entries().erase(path);
+    }
+
+private:
+
+    static std::map<std::string, Entry>& entries()
+    {
+        static std::map<std::string, Entry>* e = new std::map<std::string, Entry>;
+        return *e;
+    }
+
+};
+
+} // namespace rtps
+} // namespace fastdds
+} // namespace eprosima
+
+#endif // ifdef __VXWORKS__
+
+#endif // _FASTDDS_ROBUST_LOCK_REGISTRY_H_
