From: Andrei Kholodnyi <andrei.kholodnyi@windriver.com>
Date: Mon, 12 Oct 2026 22:10:22 +0200
Subject: [PATCH] rcutils use getprogname on VxWorks (lyrical)

---

diff --git a/src/process.c b/src/process.c
index d62c329..75d2514 100644
--- a/src/process.c
+++ b/src/process.c
@@ -60,7 +60,7 @@ char * rcutils_get_executable_name(rcutils_allocator_t allocator)
   RCUTILS_CHECK_ALLOCATOR_WITH_MSG(
     &allocator, "invalid allocator", return NULL);
 
-#if defined __APPLE__ || defined __FreeBSD__ || (defined __ANDROID__ && __ANDROID_API__ >= 21)
+#if defined __APPLE__ || defined __FreeBSD__ || defined __VXWORKS__ || (defined __ANDROID__ && __ANDROID_API__ >= 21)
   const char * appname = getprogname();
 #elif (defined __GNUC__ && !defined(__MINGW64__)) && !defined(__QNXNTO__) && !defined(__OHOS__)
   const char * appname = program_invocation_name;
